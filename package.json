{
  "name": "@mmilad/plantool",
  "version": "0.1.0",
  "description": "Git-native planning and issue tracking for people and coding agents",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "plantool": "./bin/plantool.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./schema": "./schema/plantool.schema.json"
  },
  "files": [
    "bin/",
    "src/",
    "schema/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/server.js && node --check bin/plantool.js && node --check bench/scale.mjs && node --test",
    "benchmark:scale": "node bench/scale.mjs"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.2"
  }
}
